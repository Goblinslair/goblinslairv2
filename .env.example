# Copy this file to .env and fill in real values. .env is gitignored.

# Required by scripts/sync-products.mjs and scripts/sync-paint-images.mjs
LOYVERSE_ACCESS_TOKEN=

# Optional — picks a store when the Loyverse account has more than one
LOYVERSE_STORE_ID=

# Production domain, read at build time (sitemap, canonical tags, OG/Twitter
# meta, JSON-LD). Set in Vercel's project env vars, not needed locally.
SITE_URL=

# Pooled Neon Postgres connection string (host should contain "-pooler").
# Required by the login system (src/lib/db.ts).
DATABASE_URL=

# bcrypt hash (not the plaintext password) for the /admin panel's shared
# staff login. Generate with:
#   node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "your-password-here"
ADMIN_PASSWORD_HASH=

# Fine-grained GitHub personal access token scoped to just this repo with
# Contents: Read and write. Required by the /admin panel to publish blog
# posts and events as commits.
GITHUB_TOKEN=

# owner/repo, e.g. Goblinslair/goblinslairv2
GITHUB_REPO=

# Auto-provided by Vercel when a Blob store is attached to the project
# (Storage tab → Create Database → Blob). Required for the admin panel's
# blog image upload (src/pages/api/admin/upload.ts). Not needed locally
# unless testing uploads against a real Blob store.
BLOB_READ_WRITE_TOKEN=

# FIUU (payment gateway) — Merchant ID, Verify Key, Secret Key from a
# registered FIUU account. Required for click-and-collect checkout
# (src/lib/fiuu.ts). Sandbox exists but requires whitelisting the dev/test
# IP in FIUU's sandbox portal first.
FIUU_MERCHANT_ID=
FIUU_VERIFY_KEY=
FIUU_SECRET_KEY=
FIUU_SANDBOX=true

# Loyverse payment_type_id for a dedicated "Online (FIUU)" payment method —
# create it once in Loyverse POS (Settings > Payment types) so online
# orders are visually distinct from till sales in Loyverse's own reports,
# then look up its id via GET /payment_types and paste it here. Required
# for src/lib/loyverse.ts's createLoyverseReceipt.
LOYVERSE_ONLINE_PAYMENT_TYPE_ID=

# Loyverse variant_ids for two dedicated shipping-fee products — create
# "Shipping – West Malaysia" and "Shipping – East Malaysia" once in
# Loyverse POS (their catalog price doesn't matter, the real RM10/RM15 is
# sent as a per-receipt price override) so delivery revenue shows up split
# by region in Loyverse's own sales reports. Required by
# src/lib/loyverse.ts's createLoyverseReceipt whenever a delivery order
# needs a receipt — see src/lib/shipping.ts for the region rates.
LOYVERSE_SHIPPING_VARIANT_ID_WEST=
LOYVERSE_SHIPPING_VARIANT_ID_EAST=
