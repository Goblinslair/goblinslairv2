# Copy this file to .env and fill in real values. .env is gitignored.

# Required by scripts/sync-products.mjs and scripts/sync-paint-images.mjs
LOYVERSE_ACCESS_TOKEN=

# Optional — picks a store when the Loyverse account has more than one
LOYVERSE_STORE_ID=

# Production domain, read at build time (sitemap, canonical tags, OG/Twitter
# meta, JSON-LD). Set in Vercel's project env vars, not needed locally.
SITE_URL=

# Pooled Neon Postgres connection string (host should contain "-pooler").
# Required by the login system (src/lib/db.ts).
DATABASE_URL=
