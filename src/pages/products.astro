---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

function slugify(name: string) {
  return name
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

// Loyverse category names arrive SHOUTING ("ADEPTA SORORITAS") — capitalize
// each word for the filter drawer instead of showing raw all-caps. Splits
// on whitespace only (not \b) so "EMPEROR'S" becomes "Emperor's", not
// "Emperor'S", and "T'AU" becomes "T'au" to match GW's own spelling.
function toTitleCase(name: string) {
  return name
    .split(' ')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(' ');
}

const products = await getCollection('products');
const categories = [...new Set(products.map((p) => p.data.category))].sort();

// Loyverse gives us a flat category per product — group them into game
// systems here so the filter drawer can mirror GW's own site structure.
// Anything not named below (new Loyverse categories, etc.) safely falls
// into "Hobby & Supplies" rather than disappearing from the filter.
const FORTY_K = new Set([
  "ADEPTA SORORITAS", "ADEPTUS / LEGIO CUSTODES", "ADEPTUS MECHANICUS", "AELDARI", "ASTRA MILITARUM",
  "BLACK TEMPLARS", "BLOOD ANGELS", "CHAOS SPACE MARINES", "DARK ANGELS", "DEATH GUARD", "DEATHWATCH",
  "DRUKHARI", "EMPEROR'S CHILDREN", "GENESTEALER CULTS", "IMPERIAL FISTS", "IMPERIAL KNIGHTS", "IRON HANDS",
  "LEAGUES OF VOTANN", "NECRONS", "ORKS", "SALAMANDERS", "SPACE MARINES", "SPACE WOLVES", "T'AU EMPIRE",
  "THOUSAND SONS", "TYRANIDS", "ULTRAMARINES", "WHITE SCARS", "WORLD EATERS",
]);
const AGE_OF_SIGMAR = new Set([
  "BLADES OF KHORNE", "CITIES OF SIGMAR", "DAUGHTERS OF KHAINE", "DISCIPLES OF TZEENTCH", "GLOOMSPITE GITZ",
  "HEDONITES OF SLAANESH", "HELSMITHS OF HASHUT", "IDONETH DEEPKIN", "KHARADRON OVERLORDS", "LUMINETH REALM-LORDS",
  "MAGGOTKIN OF NURGLE", "NIGHTHAUNT", "ORRUK WARCLANS", "OSSIARCH BONEREAPERS", "SERAPHON", "SKAVEN",
  "SLAVES TO DARKNESS", "SOULBLIGHT GRAVELORDS", "STORMCAST ETERNALS", "SYLVANETH",
]);
const HORUS_HERESY = new Set(["HORUS HERESY: LEGIONES ASTARTES"]);
const OTHER_GAMES = new Set(["NECROMUNDA", "BLOOD BOWL"]);

function groupFor(category: string) {
  if (FORTY_K.has(category)) return 'Warhammer 40,000';
  if (AGE_OF_SIGMAR.has(category)) return 'Age of Sigmar';
  if (HORUS_HERESY.has(category)) return 'The Horus Heresy';
  if (OTHER_GAMES.has(category)) return 'Other Games';
  return 'Hobby & Supplies';
}

// A filter "entry" is a drawer row: it carries its own display label, the
// unique id used for is-active tracking + the result chip, which real
// category slug to match against product cards, an optional name prefix
// (AND constraint — narrows within categoryMatch, or bypasses category
// entirely when categoryMatch is "*"), and an optional nameContains
// (OR condition — pulls in products from OTHER categories whose name
// mentions this term, without removing them from their own category's
// filter).
type FilterEntry = {
  label: string;
  filter: string;
  categoryMatch: string;
  namePrefix?: string;
  nameContains?: string;
};

const CATEGORY_LABEL_OVERRIDES: Record<string, string> = {
  "ADEPTUS / LEGIO CUSTODES": "Adeptus Custodes",
};

// Categories listed here skip their game-system group entirely and render
// as standalone buttons at the drawer root instead (alongside "All
// Products"), for cross-cutting product lines that don't belong to one
// faction/system.
const ROOT_CATEGORIES = new Set(["Spearhead"]);

// Extra OR-match term per root category: also pull in products from any
// category whose name contains this word, in addition to the category's
// own items. Those products stay listed under their original category
// filter too — this only adds a second way to find them.
const ROOT_CATEGORY_NAME_CONTAINS: Record<string, string> = {
  "Spearhead": "spearhead",
};

const rootEntries: FilterEntry[] = [];

const GROUP_ORDER = ['Warhammer 40,000', 'Age of Sigmar', 'The Horus Heresy', 'Other Games', 'Hobby & Supplies'];
const groupsMap = new Map(GROUP_ORDER.map((label) => [label, [] as FilterEntry[]]));
for (const category of categories) {
  const slug = slugify(category);
  const entry: FilterEntry = {
    label: CATEGORY_LABEL_OVERRIDES[category] || toTitleCase(category),
    filter: slug,
    categoryMatch: slug,
  };
  if (ROOT_CATEGORIES.has(category)) {
    if (ROOT_CATEGORY_NAME_CONTAINS[category]) entry.nameContains = ROOT_CATEGORY_NAME_CONTAINS[category];
    rootEntries.push(entry);
  } else {
    groupsMap.get(groupFor(category))!.push(entry);
  }
}

// Adeptus / Legio Custodes is one Loyverse category spanning two product
// lines: current "Adeptus Custodes" (40k) and Horus Heresy-era "Legio
// Custodes". The Adeptus Custodes filter above already covers all of
// them; this adds a second, narrower entry under Horus Heresy that only
// matches products actually named "Legio Custodes: ...".
const custodesSlug = slugify("ADEPTUS / LEGIO CUSTODES");
if (categories.includes("ADEPTUS / LEGIO CUSTODES")) {
  groupsMap.get('The Horus Heresy')!.push({
    label: "Legio Custodes",
    filter: 'legio-custodes-heresy',
    categoryMatch: custodesSlug,
    namePrefix: 'legio custodes',
  });
}

// Combat Patrol boxes exist per-faction (Combat Patrol: Necrons, Combat
// Patrol: Space Wolves, etc.) with no Loyverse category of their own —
// they're scattered across ~13 faction categories. "*" tells the filter
// script to ignore category entirely and match on name prefix alone.
// Sits at the drawer root (not nested in a group) since it cuts across
// every game system.
if (products.some((p) => /^combat patrol/i.test(p.data.name))) {
  rootEntries.push({
    label: "Combat Patrol",
    filter: 'combat-patrol',
    categoryMatch: '*',
    namePrefix: 'combat patrol',
  });
}

const groups = GROUP_ORDER
  .map((label) => ({ label, slug: slugify(label), entries: groupsMap.get(label)! }))
  .filter((g) => g.entries.length > 0);
---
<BaseLayout title="Products — Goblin's Lair">

  <div class="page-header">
    <div class="hero-eyebrow">The Range</div>
    <h1>Products</h1>
    <p>Miniatures, hobby supplies, and everything else you need to get an army on the table.</p>
  </div>

  <section class="products">
    <div class="product-search">
      <input type="search" id="product-search" placeholder="Search products…" aria-label="Search products" />
    </div>

    <div class="product-filter-bar">
      <button id="filter-drawer-open" class="btn btn-outline" type="button" aria-haspopup="dialog">
        Filter by Faction
      </button>
      <div class="active-filter-chip" id="active-filter-chip" hidden>
        <span id="active-filter-chip-text"></span>
        <button id="active-filter-chip-clear" type="button" aria-label="Clear filter">&times;</button>
      </div>
    </div>

    <div class="filter-drawer" id="filter-drawer" aria-hidden="true">
      <div class="filter-drawer-backdrop" id="filter-drawer-backdrop"></div>
      <div class="filter-drawer-panel" role="dialog" aria-modal="true" aria-label="Filter products">
        <div class="filter-drawer-header">
          <button class="filter-drawer-back" id="filter-drawer-back" type="button" aria-label="Back" hidden>&larr;</button>
          <span class="filter-drawer-title" id="filter-drawer-title">Filter by Faction</span>
          <button class="filter-drawer-close" id="filter-drawer-close" type="button" aria-label="Close">&times;</button>
        </div>
        <div class="filter-drawer-body">
          <div class="filter-drawer-view" data-view="top">
            <button class="filter-drawer-item filter-drawer-item-all" data-filter="all">All Products</button>
            {rootEntries.map((entry) => (
              <button
                class="filter-drawer-item"
                data-filter={entry.filter}
                data-category={entry.categoryMatch}
                data-name-prefix={entry.namePrefix}
                data-name-contains={entry.nameContains}
              >{entry.label}</button>
            ))}
            {groups.map((group) => (
              <button class="filter-drawer-item filter-drawer-group" data-group={group.slug} data-label={group.label}>
                {group.label}
                <span class="filter-drawer-count">{group.entries.length}</span>
                <span class="filter-drawer-chevron">&rsaquo;</span>
              </button>
            ))}
          </div>
          {groups.map((group) => (
            <div class="filter-drawer-view" data-view={group.slug} hidden>
              {group.entries.map((entry) => (
                <button
                  class="filter-drawer-item"
                  data-filter={entry.filter}
                  data-category={entry.categoryMatch}
                  data-name-prefix={entry.namePrefix}
                  data-name-contains={entry.nameContains}
                >{entry.label}</button>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="product-grid">

      {products.map((product) => (
        <a class="product-card" href={`/products/${product.id}`} data-category={slugify(product.data.category)} data-name={product.data.name.toLowerCase()}>
          <div
            class="product-img"
            style={product.data.image ? `background-image:url(${product.data.image});background-size:contain;background-repeat:no-repeat;background-position:center;` : undefined}
          >
            <div class="product-tag">{product.data.category}</div>
            {product.data.stock !== null && product.data.stock <= 0 && (
              <div class="product-badge">Out of Stock</div>
            )}
            {product.data.stock !== null && product.data.stock > 0 && product.data.stock <= 3 && (
              <div class="product-badge">Low Stock</div>
            )}
          </div>
          <div class="product-body">
            <h3>{product.data.name}</h3>
            <span class="price">RM{product.data.price.toFixed(2)}</span>
          </div>
        </a>
      ))}

    </div>

    <p class="product-empty" hidden>No products found.</p>

    <div class="product-load-more">
      <button id="product-load-more" class="btn btn-outline" hidden>Load More</button>
    </div>
  </section>

</BaseLayout>

<script src="/product-filter.js" is:inline></script>
