---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Products — Goblin's Lair">

  <div class="page-header">
    <div class="hero-eyebrow">The Range</div>
    <h1>Products</h1>
    <p>Miniatures, hobby supplies, and everything else you need to get an army on the table.</p>
  </div>

  <section class="products">
    <div class="faction-tabs">
      <button class="faction-tab is-active">All</button>
      <button class="faction-tab">Warhammer 40,000</button>
      <button class="faction-tab">Age of Sigmar</button>
      <button class="faction-tab">Paints &amp; Tools</button>
      <button class="faction-tab">Terrain</button>
    </div>

    <div class="product-grid">

      <div class="product-card">
        <div class="product-img faction-40k">
          <div class="product-tag">40K</div>
          <div class="product-badge">New</div>
        </div>
        <div class="product-body">
          <h3>Infantry Squad — Box Set</h3>
          <p>10-model plastic kit, multiple build options.</p>
          <span class="price">$45</span>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img faction-40k">
          <div class="product-tag">40K</div>
        </div>
        <div class="product-body">
          <h3>Battle Tank — War Machine Kit</h3>
          <p>Heavy armor support with interchangeable weapons.</p>
          <span class="price">$68</span>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img faction-40k">
          <div class="product-tag">40K</div>
          <div class="product-badge">Restock</div>
        </div>
        <div class="product-body">
          <h3>Combat Patrol — Starter Force</h3>
          <p>Everything needed for a first army, table-ready.</p>
          <span class="price">$120</span>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img faction-aos">
          <div class="product-tag">AoS</div>
          <div class="product-badge">New</div>
        </div>
        <div class="product-body">
          <h3>Realm Heroes — Character Set</h3>
          <p>Three-model command set with alternate poses.</p>
          <span class="price">$52</span>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img faction-aos">
          <div class="product-tag">AoS</div>
        </div>
        <div class="product-body">
          <h3>Monster Kit — Large Beast</h3>
          <p>Single-model centrepiece with dynamic base.</p>
          <span class="price">$95</span>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img faction-aos">
          <div class="product-tag">AoS</div>
          <div class="product-badge">Staff<br>Pick</div>
        </div>
        <div class="product-body">
          <h3>Battletome — Core Rules</h3>
          <p>Faction lore, rules, and warscrolls in one hardback.</p>
          <span class="price">$38</span>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img">
          <div class="product-tag">Hobby</div>
        </div>
        <div class="product-body">
          <h3>Core Paint Set — 12 Pots</h3>
          <p>Essential starter palette for new armies.</p>
          <span class="price">$40</span>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img">
          <div class="product-tag">Hobby</div>
        </div>
        <div class="product-body">
          <h3>Precision Brush Set</h3>
          <p>Three-brush set for base coats through fine detail.</p>
          <span class="price">$28</span>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img">
          <div class="product-tag">Terrain</div>
          <div class="product-badge">New</div>
        </div>
        <div class="product-body">
          <h3>Ruined Battlefield — Terrain Kit</h3>
          <p>Modular scenery pieces, unpainted resin.</p>
          <span class="price">$56</span>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
