---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Log In — Goblin's Lair">
  <div class="page-header">
    <div class="hero-eyebrow">Welcome Back</div>
    <h1>Log In</h1>
    <p>Access your account and member pricing.</p>
  </div>
  <section class="auth">
    <div class="auth-layout">
      <form class="contact-form" id="login-form">
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" placeholder="you@example.com" required>
        </div>
        <div>
          <label for="password">Password</label>
          <input type="password" id="password" placeholder="Your password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="justify-self:start;">Log In</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
      <p class="auth-switch">New here? <a href="/signup">Create an account</a></p>
    </div>
  </section>
</BaseLayout>

<script src="/login-form.js" is:inline></script>
