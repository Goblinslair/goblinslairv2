---
// Renders per-request instead of pre-building one HTML file per product —
// there are hundreds of products synced from Loyverse and that's too many
// static files to build and maintain. Content is still fully in the HTML
// response (rendered on the server before it reaches the browser), so SEO
// and link-preview crawlers see the real product info, same as a static page.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sanitizeHtml, stripHtml } from '../../lib/html';
import { getStoreId, getLiveStockForVariant } from '../../lib/loyverse-stock';
import { getReservedQtyForVariant } from '../../lib/reservations';

const { slug } = Astro.params;
const products = await getCollection('products');
const product = products.find((p) => p.id === slug);

if (!product) Astro.response.status = 404;

// Live stock overlay, same as the product grid — falls back to the synced
// snapshot's value if the live lookup fails or the product predates the
// variantId field.
if (product?.data.variantId) {
  const storeId = await getStoreId();
  const liveStock = storeId ? await getLiveStockForVariant(storeId, product.data.variantId) : null;
  if (liveStock !== null) product.data.stock = liveStock;

  // Subtract this site's own pending-checkout reservations, same reasoning
  // as products.astro — a reservation is this site's own DB fact, not
  // something Loyverse's live stock lookup above would ever reflect.
  if (product.data.stock !== null) {
    const reserved = await getReservedQtyForVariant(product.data.variantId);
    product.data.stock = Math.max(0, product.data.stock - reserved);
  }
}

const { name, description, category, price, image, sku, stock } = product?.data ?? {};
const stockLabel = stock === null || stock === undefined ? null : stock <= 0 ? 'Out of Stock' : stock <= 3 ? 'Low Stock' : 'In Stock';
const descriptionHtml = description ? sanitizeHtml(description) : '';
const descriptionText = description ? stripHtml(description) : '';

// Lets Google show price/stock directly in search results. Built from
// data already on this page — no extra fetching. Works fine even before
// SITE_URL is set for real: Astro.site just carries the placeholder
// domain until then, same as the canonical tag above already does.
const productJsonLd = product ? {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: descriptionText || undefined,
  image: image || undefined,
  sku: sku || undefined,
  category,
  offers: {
    '@type': 'Offer',
    url: new URL(Astro.url.pathname, Astro.site).href,
    priceCurrency: 'MYR',
    price: price!.toFixed(2),
    availability: stock !== null && stock !== undefined && stock <= 0
      ? 'https://schema.org/OutOfStock'
      : 'https://schema.org/InStock',
  },
} : null;
---
<BaseLayout
  title={product ? `${name} — Goblin's Lair` : "Product Not Found — Goblin's Lair"}
  description={product ? (descriptionText || undefined) : undefined}
  image={image || undefined}
  jsonLd={productJsonLd || undefined}
>

  {product ? (
    <section class="product-detail">
      <div
        class="product-detail-img"
        style={image ? `background-image:url(${image});background-size:contain;background-repeat:no-repeat;background-position:center;` : undefined}
      >
        {stockLabel && <div class="product-badge">{stockLabel}</div>}
      </div>

      <div class="product-detail-body">
        <div class="hero-eyebrow">{category}</div>
        <h1>{name}</h1>
        <span class="price">RM{price.toFixed(2)}</span>
        {descriptionHtml && <div class="product-description" set:html={descriptionHtml} />}
        {sku && <p class="product-sku">SKU: {sku}</p>}
        {stockLabel && <p class="product-stock">{stockLabel}</p>}
        {stockLabel === 'Out of Stock' ? (
          <button type="button" class="btn btn-primary out-of-stock-btn" disabled>Out of Stock</button>
        ) : (
          <div class="cart-controls" data-slug={product.id} data-name={name} data-price={price} data-image={image ?? ''} data-stock={stock ?? ''} data-variant-id={product.data.variantId ?? ''}>
            <div class="qty-stepper">
              <button type="button" class="qty-btn" data-qty-decrease aria-label="Decrease quantity">&minus;</button>
              <input type="number" class="qty-input" value="1" min="1" aria-label="Quantity">
              <button type="button" class="qty-btn" data-qty-increase aria-label="Increase quantity">&plus;</button>
            </div>
            <button type="button" class="btn btn-primary add-to-cart-btn">Add to Cart</button>
            <a href="/cart" class="btn btn-outline go-to-cart-btn" hidden>Go to Cart &rarr;</a>
          </div>
        )}
        <a class="btn" href="/products">&larr; Back to Products</a>

      </div>
    </section>
  ) : (
    <>
      <div class="page-header">
        <div class="hero-eyebrow">Lost in the Warp</div>
        <h1>Product Not Found</h1>
        <p>This item isn't in the range, or it's been delisted.</p>
      </div>
      <section class="not-found">
        <a href="/products" class="btn btn-primary">Shop the Range</a>
        <a href="/" class="btn btn-outline">Back Home</a>
      </section>
    </>
  )}

</BaseLayout>

<script src="/product-detail.js" is:inline></script>
