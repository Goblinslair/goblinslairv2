---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { slugify } from '../lib/product-groups';

// Photography lives in src/assets/images/ rather than public/ so Astro's
// image pipeline can resize and re-encode it at build time. Drop a file in
// named hero-1, reason-1, and so on — .jpg, .jpeg, and .png are all matched,
// and the originals are never modified. Anything with no matching file keeps
// the CSS gradient placeholder instead.
const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{jpg,jpeg,png}',
  { eager: true },
);

const imagesByName = new Map<string, ImageMetadata>(
  Object.entries(imageFiles).map(([filePath, module]) => [
    filePath.split('/').pop()!.replace(/\.(jpg|jpeg|png)$/, ''),
    module.default,
  ]),
);

// width is the widest the image is ever displayed at, doubled for high-DPI
// screens. Quality is set well below the WebP default: these are decorative
// background photos, and the default re-encode can land larger than the
// source JPEG.
async function backgroundStyle(basename: string, width: number) {
  const source = imagesByName.get(basename);
  if (!source) return undefined;
  const optimized = await getImage({
    src: source,
    width: Math.min(width, source.width), // never upscale past the original
    format: 'webp',
    quality: 70,
  });
  return `background-image:url('${optimized.src}');`;
}

// Slides are dropped where a numbered file is missing, so the slideshow only
// ever renders photos that actually exist rather than blank panes.
const heroSlides = (
  await Promise.all([1, 2, 3, 4, 5].map((n) => backgroundStyle(`hero-${n}`, 1920)))
).filter((style): style is string => style !== undefined);
const reasonImages = await Promise.all(
  [1, 2, 3, 4, 5].map((n) => backgroundStyle(`reason-${n}`, 1440)),
);

// FACTION INTRO section cards — same drop-in-a-file-named-X convention,
// smaller since each is a third-width card rather than a full banner.
const faction40kImage = await backgroundStyle('faction-40k', 800);
const factionAosImage = await backgroundStyle('faction-aos', 800);
const factionHobbyImage = await backgroundStyle('faction-hobby', 800);

// Events come from src/content/events/*.md (see HOW-TO.md). Soonest-first,
// capped at four. If nothing is booked in the future, fall back to the most
// recent past events instead of showing an empty section.
const allEvents = (await getCollection('events')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingEvents = allEvents.filter((event) => event.data.date >= today);
const isRecap = upcomingEvents.length === 0;
const displayEvents = (isRecap ? [...allEvents].reverse() : upcomingEvents).slice(0, 4);
const featuredEvent = displayEvents[0];

function formatEventDate(date: Date) {
  const day = String(date.getDate()).padStart(2, '0');
  const month = String(date.getMonth() + 1).padStart(2, '0');
  return `${day} / ${month}`;
}
function formatFeaturedDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: '2-digit' });
}
---
<BaseLayout title="Goblin's Lair — Warhammer &amp; Tabletop Hobby Shop">

  <!-- HERO -->
  <section class="hero" id="hero-slideshow">
    <!-- Slides come from src/assets/images/hero-N. Extend the list in the
         frontmatter to add more; the dots below and the slideshow script both
         follow whatever gets rendered here. -->
    <div class="hero-slides" data-parallax="0.12">
      {heroSlides.map((style, i) => (
        <div class={i === 0 ? 'hero-slide is-active' : 'hero-slide'} style={style}></div>
      ))}
    </div>
    <div class="hero-frame-vignette"></div>

    <button class="hero-arrow hero-arrow-left" type="button" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <button class="hero-arrow hero-arrow-right" type="button" aria-label="Next slide">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
    </button>

    <div class="hero-content">
      <div class="hero-eyebrow">Welcome To Your New Obsession</div>
      <h1>Your Army Starts<br>in the Lair</h1>
      <p>Miniatures, paints and accessories for Warhammer 40,000 and Age of Sigmar — stocked and battle-tested by people who actually play.</p>
      <a href="/products" class="btn btn-primary">Shop the Range</a>
      <a href="/about" class="btn btn-outline" style="margin-left:16px;">Our Story</a>
    </div>

    <div class="hero-dots">
      {heroSlides.map((_, i) => (
        <button
          class={i === 0 ? 'hero-dot is-active' : 'hero-dot'}
          type="button"
          aria-label={`Go to slide ${i + 1}`}
        ></button>
      ))}
    </div>

    <div class="hero-scrollcue">
      <span>Enter the Lair</span>
      <i></i>
    </div>
  </section>

  <!-- REASONS -->
  <section class="reasons">
    <div class="watermark"></div>
    <div class="section-head">
      <div class="section-eyebrow">Reasons</div>
      <h2>Why Hobbyists Choose<br>the Lair</h2>
      <p>Five reasons our regulars keep coming back, table after table.</p>
    </div>

    <div class="reasons-collage">

      <div class="reason-row" data-reveal>
        <div class="reason-img" data-parallax="0.05" style={reasonImages[0]}></div>
        <div class="reason-text">
          <span class="reason-num">01</span>
          <h3>Built For Hobbying</h3>
          <p>Six painting tables, five gaming tables. Plenty of room to paint, play, and not get in each other's way.</p>
        </div>
      </div>

      <div class="reason-row" data-reveal>
        <div class="reason-img" data-parallax="0.05" style={reasonImages[1]}></div>
        <div class="reason-text">
          <span class="reason-num">02</span>
          <h3>Deep Stock, Both Armies</h3>
          <p>A serious range across Warhammer 40,000 and Age of Sigmar, restocked weekly so there's always something new to grab.</p>
        </div>
      </div>

      <div class="reason-row" data-reveal>
        <div class="reason-img" data-parallax="0.05" style={reasonImages[2]}></div>
        <div class="reason-text">
          <span class="reason-num">03</span>
          <h3>Advice From People Who Actually Play</h3>
          <p>Everyone behind the counter runs their own army. Ask a rules question, get a real answer.</p>
        </div>
      </div>

      <div class="reason-row" data-reveal>
        <div class="reason-img" data-parallax="0.05" style={reasonImages[3]}></div>
        <div class="reason-text">
          <span class="reason-num">04</span>
          <h3>There's Always Something On</h3>
          <p>Painting workshops, narrative campaigns, new release nights, and weekends where the community just shows up to chill and throw down some games. Check the events list below for what's next.</p>
        </div>
      </div>

      <div class="reason-row" data-reveal>
        <div class="reason-img" data-parallax="0.05" style={reasonImages[4]}></div>
        <div class="reason-text">
          <span class="reason-num">05</span>
          <h3>A Community Worth Joining</h3>
          <p>New players, veteran generals, and everyone in between — here for casual games, occasional competitive ones, and everything in between. First-timers get paired with someone happy to show them the ropes.</p>
        </div>
      </div>

    </div>

    <div style="text-align:center; margin-top: 20px;">
      <a href="/about" class="btn btn-outline">Meet the Keepers</a>
    </div>
  </section>

  <!-- EVENTS -->
  {displayEvents.length > 0 && (
    <section class="events">
      <div class="watermark"></div>
      <div class="events-layout">

        <div
          class="events-image"
          data-parallax="0.06"
          style={featuredEvent.data.image ? `background-image:url(${featuredEvent.data.image});background-size:cover;background-position:center;` : undefined}
        >
          <div class="events-feature-card">
            <div class="efc-info">
              <span>{isRecap ? 'Recap' : 'Featured'} &middot; {formatFeaturedDate(featuredEvent.data.date)}</span>
              <strong>{featuredEvent.data.title}</strong>
            </div>
            {!isRecap && <a href="/blog" class="btn">Reserve Spot</a>}
          </div>
        </div>

        <div class="events-list">
          <div class="section-head">
            <div class="section-eyebrow">{isRecap ? 'Recap' : 'Events'}</div>
            <h2>{isRecap ? 'Recently at the Lair' : "What's On at the Lair"}</h2>
            {isRecap && <p>Nothing booked yet for the weeks ahead — here's what we got up to last.</p>}
          </div>

          {displayEvents.map((event, i) => (
            <div class={i === 0 ? 'event-row is-featured' : 'event-row'} data-reveal>
              <span class="event-date">{formatEventDate(event.data.date)}</span>
              <div class="event-info">
                <h3>{event.data.title}</h3>
                <p>{event.data.excerpt}</p>
              </div>
              <a href="/blog" class="event-link">View Details</a>
            </div>
          ))}
        </div>

      </div>
    </section>
  )}

  <!-- FACTION INTRO -->
  <section class="products">
    <div class="section-head">
      <div class="section-eyebrow">Two Armies, One Lair</div>
      <h2>Grimdark Sci-Fi. Dark Fantasy.</h2>
      <p>Whichever tabletop you're building for, we've got the range covered.</p>
    </div>
    <div class="product-grid">
      <div class="product-card">
        <div class="product-img faction-40k" style={faction40kImage ? `${faction40kImage}background-size:cover;background-position:center;` : undefined}><div class="product-tag">40K</div></div>
        <div class="product-body">
          <h3>Warhammer 40,000</h3>
          <p>Infantry squads, war machines, and full battleforce boxes for the grim darkness of the far future.</p>
          <a href={`/products?system=${slugify('Warhammer 40,000')}`} class="blog-link" style="margin-top:12px; display:inline-block;">Shop 40K &rarr;</a>
        </div>
      </div>
      <div class="product-card">
        <div class="product-img faction-aos" style={factionAosImage ? `${factionAosImage}background-size:cover;background-position:center;` : undefined}><div class="product-tag">AoS</div></div>
        <div class="product-body">
          <h3>Age of Sigmar</h3>
          <p>Realmforged heroes, monsters, and battletomes for the mortal realms.</p>
          <a href={`/products?system=${slugify('Age of Sigmar')}`} class="blog-link" style="margin-top:12px; display:inline-block;">Shop AoS &rarr;</a>
        </div>
      </div>
      <div class="product-card">
        <div class="product-img" style={factionHobbyImage ? `${factionHobbyImage}background-size:cover;background-position:center;` : undefined}><div class="product-tag">Hobby</div></div>
        <div class="product-body">
          <h3>Paints &amp; Tools</h3>
          <p>Full paint racks, brushes, bases, and terrain-building supplies to finish the job.</p>
          <a href={`/products?system=${slugify('Hobby & Supplies')}`} class="blog-link" style="margin-top:12px; display:inline-block;">Shop Hobby &rarr;</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script src="/hero-slideshow.js" is:inline></script>
<script src="/parallax.js" is:inline></script>
<script src="/scroll-reveal.js" is:inline></script>
