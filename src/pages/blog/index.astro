---
// Rendered per request so a post saved in /admin shows straight away.
// Pages are ?page=2, ?page=3... rather than /blog/2: /blog/[slug] would
// otherwise claim those URLs now that neither route is pre-built.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { listPosts } from '../../lib/content';
import { SHOW_BLOG_AND_EVENTS } from '../../lib/site-config';

// Hidden for now (see src/lib/site-config.ts). An empty 404 serves the site's 404 page.
if (!SHOW_BLOG_AND_EVENTS) return new Response(null, { status: 404 });

const PAGE_SIZE = 9;
const allPosts = await listPosts();
const lastPage = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam === null ? 1 : Number(pageParam);
if (!Number.isInteger(currentPage) || currentPage < 1 || currentPage > lastPage) {
  return Astro.redirect('/blog');
}

const pageUrl = (n: number) => (n === 1 ? '/blog' : `/blog?page=${n}`);
const page = {
  currentPage,
  lastPage,
  data: allPosts.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE),
  url: {
    prev: currentPage > 1 ? pageUrl(currentPage - 1) : undefined,
    next: currentPage < lastPage ? pageUrl(currentPage + 1) : undefined,
  },
};
const isFirstPage = page.currentPage === 1;
const [featured, ...rest] = isFirstPage ? page.data : [undefined, ...page.data];

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---
<BaseLayout title="Blog — Goblin's Lair">

  <div class="page-header">
    <div class="hero-eyebrow">Dispatches</div>
    <h1>The Lair Blog</h1>
    <p>Painting guides, restock notes, and results from our Saturday tables.</p>
  </div>

  <section class="blog">
    {featured && (
      <div class="blog-feature">
        <div class="blog-feature-img"></div>
        <div class="blog-feature-body">
          <span class="blog-date">{formatDate(featured.data.date)}</span>
          <h2 style="font-size:1.6rem; margin-bottom:14px;">{featured.data.title}</h2>
          <p style="color: rgba(42,26,18,0.7); margin-bottom:18px;">{featured.data.excerpt}</p>
          <a href={`/blog/${featured.id}`} class="blog-link">Read the Full Story</a>
        </div>
      </div>
    )}

    <div class="blog-grid">
      {rest.map((post) => (
        <div class="blog-card">
          <div class="blog-thumb"></div>
          <span class="blog-date">{formatDate(post.data.date)}</span>
          <h3>{post.data.title}</h3>
          <p>{post.data.excerpt}</p>
          <a href={`/blog/${post.id}`} class="blog-link">Read More</a>
        </div>
      ))}
    </div>

    {page.lastPage > 1 && (
      <nav class="pagination">
        {page.url.prev ? (
          <a href={page.url.prev} class="pagination-link">&larr; Newer</a>
        ) : (
          <span class="pagination-link is-disabled">&larr; Newer</span>
        )}
        <span class="pagination-status">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="pagination-link">Older &rarr;</a>
        ) : (
          <span class="pagination-link is-disabled">Older &rarr;</span>
        )}
      </nav>
    )}
  </section>

</BaseLayout>
