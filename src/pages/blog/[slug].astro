---
// Rendered per request so a post saved in /admin shows straight away.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPost, renderMarkdown } from '../../lib/content';
import { SHOW_BLOG_AND_EVENTS } from '../../lib/site-config';

// Hidden for now (see src/lib/site-config.ts).
if (!SHOW_BLOG_AND_EVENTS) return new Response(null, { status: 404 });

const post = Astro.params.slug ? await getPost(Astro.params.slug) : undefined;
// An empty 404 makes Astro serve the site's own 404 page.
if (!post) return new Response(null, { status: 404 });
const contentHtml = renderMarkdown(post.body);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

// Marks this page as an article for Google (headline/date/description),
// same "works fine before SITE_URL is set" reasoning as the product page's
// Product schema. No image field exists on a blog post (the blog_posts
// table only has title/date/excerpt/body) — image is optional on BlogPosting, so it's
// just omitted rather than trying to pull one out of the post body.
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date.toISOString(),
  description: post.data.excerpt,
  author: { '@type': 'Organization', name: "Goblin's Lair" },
  publisher: { '@type': 'Organization', name: "Goblin's Lair" },
};
---
<BaseLayout title={`${post.data.title} — Goblin's Lair`} description={post.data.excerpt} jsonLd={articleJsonLd}>

  <div class="page-header">
    <div class="hero-eyebrow">Dispatch &middot; {formatDate(post.data.date)}</div>
    <h1>{post.data.title}</h1>
  </div>

  <section class="blog">
    <article class="blog-post-body">
      <Fragment set:html={contentHtml} />
    </article>
    <p style="text-align:center; margin-top:40px;">
      <a href="/blog" class="blog-link">&larr; Back to All Posts</a>
    </p>
  </section>

</BaseLayout>
