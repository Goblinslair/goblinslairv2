---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Same drop-in-a-named-file convention as index.astro: put keeper-1.jpg (etc.)
// in src/assets/images/ and it replaces the CSS gradient placeholder below.
const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{jpg,jpeg,png}',
  { eager: true },
);
const imagesByName = new Map<string, ImageMetadata>(
  Object.entries(imageFiles).map(([filePath, module]) => [
    filePath.split('/').pop()!.replace(/\.(jpg|jpeg|png)$/, ''),
    module.default,
  ]),
);
async function backgroundStyle(basename: string, width: number) {
  const source = imagesByName.get(basename);
  if (!source) return undefined;
  const optimized = await getImage({
    src: source,
    width: Math.min(width, source.width),
    format: 'webp',
    quality: 70,
  });
  return `background-image:url('${optimized.src}');background-size:cover;background-position:center;`;
}
const keeperImages = await Promise.all(
  [1, 2].map((n) => backgroundStyle(`keeper-${n}`, 360)),
);
const storyImage = await backgroundStyle('about-story', 1000);
---
<BaseLayout title="About Us — Goblin's Lair">

  <div class="page-header">
    <div class="hero-eyebrow">Who We Are</div>
    <h1>About Goblin's Lair</h1>
    <p>A hobby shop built by people who'd rather be at the painting or gaming table than anywhere else.</p>
  </div>

  <section class="about" style="padding-bottom: 0;">
    <div class="about-inner">
      <div class="about-art" style={storyImage}>{!storyImage && <div class="seal">GL</div>}</div>
      <div class="about-copy">
        <div class="section-eyebrow">Our Story</div>
        <h2>Two nerds came together with one goal in mind</h2>
        <p>Goblin's Lair was an idea that was brewing for a year: Can a miniature games space be a hub for people to come together and enjoy the hobby under one roof?</p>
        <p>Today we have a budding community of new and old hobbyists enjoying the hobby together, sharing stories regardless of whether it's about the hobby or life. We welcome all people from different walks of life to come visit The Lair and become part of something bigger.</p>
      </div>
    </div>

    <div class="stat-row">
      <div class="stat"><b>1</b><span>Year Open</span></div>
      <div class="stat"><b>3</b><span>Game Systems Stocked</span></div>
      <div class="stat"><b>6</b><span>Painting Tables</span></div>
      <div class="stat"><b>20+</b><span>Saturday & Sunday Regulars</span></div>
    </div>
  </section>

  <div class="torn">
    <svg viewBox="0 0 1200 40" preserveAspectRatio="none">
      <path d="M0,0 L1200,0 L1200,20 L1180,8 L1150,24 L1120,6 L1090,22 L1060,10 L1030,26 L1000,8 L970,20 L940,4 L910,24 L880,10 L850,22 L820,6 L790,26 L760,12 L730,20 L700,6 L670,24 L640,10 L610,22 L580,4 L550,20 L520,8 L490,24 L460,10 L430,22 L400,6 L370,26 L340,12 L310,20 L280,6 L250,24 L220,10 L190,22 L160,4 L130,20 L100,8 L70,24 L40,10 L10,22 L0,10 Z" fill="var(--maroon)"/>
    </svg>
  </div>

  <section class="products">
    <div class="section-head">
      <div class="section-eyebrow">Meet the Keepers</div>
      <h2>The People Behind the Counter</h2>
      <p>The founders of Goblin's Lair</p>
    </div>
    <div class="team-grid">
      <div class="team-card">
        <div class="team-photo" style={keeperImages[0]}></div>
        <h3>Wesley Goh</h3>
        <span>I can't stop painting red, please help</span>
        <p>Massive knowledge of Warhammer lore and products. Part of the hobby for 15+ years.</p>
      </div>
      <div class="team-card">
        <div class="team-photo" style={keeperImages[1]}></div>
        <h3>Tarvin Gill</h3>
        <span>Buys cool models, loses all games</span>
        <p>Blown away with Warhammer lore since he was 10 years old, now keeps the background work of Goblin's Lair running.</p>
      </div>
    </div>
  </section>

  <section class="contact" style="padding-top: 80px;">
    <div class="section-eyebrow">Visit the Lair</div>
    <h2>Come Play a Game</h2>
    <p class="lead">Five tables, always open for a pickup game or a painting session.</p>
    <a href="/contact" class="btn btn-primary">Get Directions</a>
  </section>

</BaseLayout>
