---
// Server-rendered so the membership discount (a live Loyverse lookup, same
// as account.astro) can be resolved once at request time and handed to the
// client as a plain percentage — the cart contents themselves stay in
// localStorage and are rendered client-side by cart-page.js.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getSessionCustomer, SESSION_COOKIE } from '../lib/auth';
import { getMembershipTier } from '../lib/loyverse';
import { MALAYSIA_STATES } from '../lib/shipping';

const token = Astro.cookies.get(SESSION_COOKIE)?.value;
const customer = token ? await getSessionCustomer(token) : null;
const tier = customer ? await getMembershipTier(customer.email) : { level: null, discountPercent: 0 };
---
<BaseLayout title="Your Cart — Goblin's Lair">

  <div class="page-header">
    <div class="hero-eyebrow">Your Haul</div>
    <h1>Cart</h1>
  </div>

  <section class="cart-page">
    <div class="cart-items" id="cart-items"></div>
    <p class="cart-empty" id="cart-empty" hidden>Your cart is empty. <a href="/products">Browse the range &rarr;</a></p>

    <div class="cart-summary" id="cart-summary" hidden data-discount-percent={tier.discountPercent}>
      <div class="cart-subtotal">
        <span>Subtotal</span>
        <span id="cart-subtotal-value">RM0.00</span>
      </div>
      <div class="cart-discount-row" id="cart-discount-row" hidden>
        <span id="cart-discount-label">Member Discount</span>
        <span id="cart-discount-value">-RM0.00</span>
      </div>
      <div class="cart-discount-row" id="cart-shipping-row" hidden>
        <span>Shipping</span>
        <span id="cart-shipping-value">RM0.00</span>
      </div>
      <div class="cart-total-row">
        <span>Total</span>
        <span id="cart-total-value">RM0.00</span>
      </div>

      {customer && (
        <div class="fulfillment-options" id="fulfillment-options">
          <label class="fulfillment-option">
            <input type="radio" name="fulfillment-method" id="fulfillment-pickup" value="pickup" checked>
            Pick Up In-Store
          </label>
          <label class="fulfillment-option">
            <input type="radio" name="fulfillment-method" id="fulfillment-delivery" value="delivery">
            Delivery
          </label>
        </div>
      )}

      {customer && (
        <div class="contact-form delivery-fields" id="delivery-fields" hidden>
          <div>
            <label for="ship-line1">Address Line 1</label>
            <input type="text" id="ship-line1" placeholder="Unit/house no., street" required>
          </div>
          <div>
            <label for="ship-line2">Address Line 2 (optional)</label>
            <input type="text" id="ship-line2" placeholder="Apartment, building, etc.">
          </div>
          <div>
            <label for="ship-city">City</label>
            <input type="text" id="ship-city" required>
          </div>
          <div>
            <label for="ship-postcode">Postcode</label>
            <input type="text" id="ship-postcode" maxlength="5" inputmode="numeric" placeholder="5 digits" required>
          </div>
          <div>
            <label for="ship-state">State</label>
            <select id="ship-state" required>
              <option value="">Select a state…</option>
              {MALAYSIA_STATES.map((s) => (
                <option value={s.name} data-region={s.region}>{s.name}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="ship-phone">Phone Number</label>
            <input type="tel" id="ship-phone" placeholder="For the courier" required>
          </div>
        </div>
      )}

      {customer ? (
        <>
          {tier.level === null && (
            <p class="cart-note">Not one of our goblins yet? Ask in-store to fix that.</p>
          )}
          <p class="cart-note" id="fulfillment-note">Pay online now, pick up in-store — no shipping.</p>
          <button type="button" class="btn btn-primary" id="cart-checkout-btn">Checkout</button>
        </>
      ) : (
        <>
          <p class="cart-note">Sign in to check out and get your member pricing applied.</p>
          <a href="/login?redirect=/cart" class="btn btn-primary" id="cart-checkout-btn">Sign In to Checkout</a>
        </>
      )}
    </div>

    <div class="cart-terms">
      <h3>Terms &amp; Conditions</h3>
      <p><strong>Payment.</strong> Online orders are paid securely at checkout. Prices and stock reflect our live inventory but may change between browsing and payment in rare cases — if that happens, we'll contact you before completing your order.</p>
      <p><strong>Pick Up In-Store.</strong> Once payment is confirmed, your order will be ready for collection any time during our opening hours. Please bring your order confirmation.</p>
      <p><strong>Delivery.</strong> Orders for delivery are dispatched within a few business days of payment, to the address provided at checkout. Please double-check your address and phone number before paying — we can't guarantee changes after an order is placed.</p>
      <p><strong>Cancellations.</strong> Once payment is confirmed, orders cannot be cancelled or changed online. If you need to cancel or make a change, contact us as soon as possible and we'll do our best to help.</p>
      <p><strong>Returns &amp; Exchanges.</strong> All sales are final — we don't accept returns for change of mind. If an item arrives damaged, defective, or incorrect, let us know within 7 days of pickup or delivery and we'll arrange an exchange or refund.</p>
      <p>Questions about an order? Reach us any time via <a href="/contact">Contact</a> or <a href="mailto:goblinslairpj@gmail.com">goblinslairpj@gmail.com</a>.</p>
    </div>
  </section>

</BaseLayout>

<script src="/cart-page.js" is:inline></script>
