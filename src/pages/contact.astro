---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Us — Goblin's Lair">

  <div class="page-header">
    <div class="hero-eyebrow">Send a Raven</div>
    <h1>Contact Us</h1>
    <p>Questions, custom orders, or table bookings — the Lair always answers.</p>
  </div>

  <section class="contact">
    <div class="contact-layout">
      <form class="contact-form">
        <div>
          <label for="name">Name</label>
          <input type="text" id="name" placeholder="Your name">
        </div>
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" placeholder="you@example.com">
        </div>
        <div>
          <label for="topic">Topic</label>
          <select id="topic">
            <option>General Question</option>
            <option>Custom Order</option>
            <option>Painting Commission</option>
            <option>Table Booking</option>
          </select>
        </div>
        <div>
          <label for="message">Message</label>
          <textarea id="message" placeholder="What can we find for you?"></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="justify-self:start;">Send Message</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>

      <div class="contact-info">
        <div class="contact-info-block">
          <strong>Email</strong>
          <p>goblinslairpj@gmail.com</p>
        </div>
        <div class="contact-info-block">
          <strong>Hours</strong>
          <p>Wed–Fri, 1:30pm–8:30pm<br>Sat–Sun, 12:30pm–9pm<br>Closed Mon &amp; Tue</p>
        </div>
        <div class="contact-info-block">
          <strong>Location</strong>
          <p>84A, Jalan SS 24/2, Taman Megah<br>47301 Petaling Jaya, Selangor</p>
        </div>
        <iframe
          class="contact-map"
          src="https://maps.google.com/maps?q=84A+Jalan+SS+24%2F2+Taman+Megah+47301+Petaling+Jaya+Selangor&output=embed"
          title="Map to Goblin's Lair"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <a href="https://maps.app.goo.gl/ps52aJBpJMBxz3GS7" target="_blank" rel="noopener noreferrer" class="blog-link">View on Google Maps &rarr;</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script src="/contact-form.js" is:inline></script>
