---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { ADMIN_SESSION_COOKIE, isValidAdminSession } from '../../lib/admin-auth';
import { sql } from '../../lib/db';

const token = Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value;
const isAdmin = token ? await isValidAdminSession(token) : false;

if (!isAdmin) {
  return Astro.redirect('/admin/login');
}

// Read straight from the database (not the public pages' cache) so staff
// always see what they just saved.
type Item = { slug: string; title: string };
let posts: Item[] = [];
let events: Item[] = [];
let loadError = '';
try {
  [posts, events] = await Promise.all([
    sql<Item[]>`SELECT slug, title FROM blog_posts ORDER BY date DESC, slug`,
    sql<Item[]>`SELECT slug, title FROM events ORDER BY date DESC, slug`,
  ]);
} catch (err) {
  loadError = err instanceof Error ? err.message : 'Failed to load posts and events.';
}
---
<BaseLayout title="Admin — Goblin's Lair">
  <div class="page-header">
    <div class="hero-eyebrow">Staff Only</div>
    <h1>Admin</h1>
    <button type="button" class="btn btn-outline" id="admin-logout-btn">Log Out</button>
  </div>

  <section class="auth">
    <div class="auth-layout">
      {loadError && <p class="form-status is-error" style="opacity:1;">{loadError}</p>}

      <div class="account-section">
        <h3>Blog Posts</h3>
        <p><a href="/admin/blog/new" class="btn btn-primary">New Post</a></p>
        <ul class="admin-list">
          {posts.map((post) => (
            <li>
              <span>{post.title}</span>
              <span class="admin-list-actions">
                <a href={`/admin/blog/${post.slug}/edit`}>Edit</a>
                <a href={`/blog/${post.slug}`} target="_blank">View</a>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="account-section">
        <h3>Events</h3>
        <p><a href="/admin/events/new" class="btn btn-primary">New Event</a></p>
        <ul class="admin-list">
          {events.map((event) => (
            <li>
              <span>{event.title}</span>
              <span class="admin-list-actions">
                <a href={`/admin/events/${event.slug}/edit`}>Edit</a>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="account-section">
        <h3>Orders</h3>
        <p><a href="/admin/orders" class="btn btn-primary">View Orders</a></p>
      </div>

      <div class="account-section">
        <h3>Products</h3>
        <p>Products and stock come from Loyverse. Change them there, not here. The website picks up changes every hour by itself, or press this to do it now.</p>
        <p><button type="button" class="btn btn-primary" id="admin-sync-btn">Sync Products Now</button></p>
        <p class="form-status" id="admin-sync-status" role="status"></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script src="/admin-logout.js" is:inline></script>
<script src="/admin-sync.js" is:inline></script>
