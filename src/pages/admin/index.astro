---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { ADMIN_SESSION_COOKIE, isValidAdminSession } from '../../lib/admin-auth';
import { listDir, getFile } from '../../lib/github-content';
import { parseFrontmatter } from '../../lib/markdown';

const token = Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value;
const isAdmin = token ? await isValidAdminSession(token) : false;

if (!isAdmin) {
  return Astro.redirect('/admin/login');
}

async function listItems(dir: string) {
  const entries = await listDir(dir);
  const items = await Promise.all(
    entries.map(async (entry) => {
      const slug = entry.name.replace(/\.md$/, '');
      const file = await getFile(`${dir}/${slug}.md`);
      const parsed = file ? parseFrontmatter(file.content) : null;
      return { slug, title: parsed?.title || slug, date: parsed?.date || '' };
    })
  );
  return items.sort((a, b) => (a.date < b.date ? 1 : -1));
}

let posts: Awaited<ReturnType<typeof listItems>> = [];
let events: Awaited<ReturnType<typeof listItems>> = [];
let loadError = '';
try {
  [posts, events] = await Promise.all([listItems('src/content/blog'), listItems('src/content/events')]);
} catch (err) {
  loadError = err instanceof Error ? err.message : 'Failed to load content from GitHub.';
}
---
<BaseLayout title="Admin — Goblin's Lair">
  <div class="page-header">
    <div class="hero-eyebrow">Staff Only</div>
    <h1>Admin</h1>
    <button type="button" class="btn btn-outline" id="admin-logout-btn">Log Out</button>
  </div>

  <section class="auth">
    <div class="auth-layout">
      {loadError && <p class="form-status is-error" style="opacity:1;">{loadError}</p>}

      <div class="account-section">
        <h3>Blog Posts</h3>
        <p><a href="/admin/blog/new" class="btn btn-primary">New Post</a></p>
        <ul class="admin-list">
          {posts.map((post) => (
            <li>
              <span>{post.title}</span>
              <span class="admin-list-actions">
                <a href={`/admin/blog/${post.slug}/edit`}>Edit</a>
                <a href={`/blog/${post.slug}`} target="_blank">View</a>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="account-section">
        <h3>Events</h3>
        <p><a href="/admin/events/new" class="btn btn-primary">New Event</a></p>
        <ul class="admin-list">
          {events.map((event) => (
            <li>
              <span>{event.title}</span>
              <span class="admin-list-actions">
                <a href={`/admin/events/${event.slug}/edit`}>Edit</a>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script src="/admin-logout.js" is:inline></script>
