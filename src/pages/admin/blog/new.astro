---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ADMIN_SESSION_COOKIE, isValidAdminSession } from '../../../lib/admin-auth';

const token = Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value;
const isAdmin = token ? await isValidAdminSession(token) : false;
if (!isAdmin) return Astro.redirect('/admin/login');
---
<BaseLayout title="New Blog Post — Goblin's Lair">
  <div class="page-header">
    <div class="hero-eyebrow">Staff Only</div>
    <h1>New Blog Post</h1>
  </div>
  <section class="auth">
    <div class="auth-layout">
      <form class="contact-form" id="admin-blog-form" data-mode="create">
        <div>
          <label for="title">Title</label>
          <input type="text" id="title" required>
        </div>
        <div>
          <label for="date">Date</label>
          <input type="date" id="date" required>
        </div>
        <div>
          <label for="excerpt">Excerpt</label>
          <input type="text" id="excerpt" placeholder="One-line summary shown on the blog listing page." required>
        </div>
        <div>
          <label for="admin-image-input">Add Image</label>
          <input type="file" id="admin-image-input" accept="image/*">
          <p id="admin-image-status" role="status" aria-live="polite"></p>
        </div>
        <div>
          <label for="body">Body (Markdown)</label>
          <textarea id="body" rows="14" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="justify-self:start;">Publish</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
      <p class="auth-switch"><a href="/admin">&larr; Back to Admin</a></p>
    </div>
  </section>
</BaseLayout>

<script src="/admin-image-upload.js" is:inline></script>
<script src="/admin-blog-form.js" is:inline></script>
